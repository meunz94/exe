{
  "name": "byhome",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "posts": "node scripts/generate-posts.mjs",
    "au-posts": "node scripts/generate-au-posts.mjs",
    "gallery": "node scripts/generate-gallery.mjs",
    "scripts-index": "node scripts/generate-scripts.mjs",
    "changelog": "node scripts/generate-changelog.mjs",
    "dev": "npm run posts && npm run au-posts && npm run gallery && npm run scripts-index && npm run changelog && vite",
    "build": "npm run posts && npm run au-posts && npm run gallery && npm run scripts-index && npm run changelog && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "models": "node scripts/optimize-models.mjs",
    "boot-scene": "node scripts/boot-scene.mjs",
    "notion:sync": "node --env-file-if-exists=.env scripts/notion-sync.mjs",
    "notion:push": "node --env-file-if-exists=.env scripts/notion-push.mjs",
    "notion:bootstrap": "node --env-file-if-exists=.env scripts/notion-bootstrap.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.7",
    "@react-three/fiber": "^9.5.0",
    "@types/three": "^0.183.1",
    "lenis": "^1.3.25",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "three": "^0.183.2"
  },
  "lint-staged": {
    "*.{jpg,jpeg,png,webp,tiff,bmp}": "node scripts/strip-exif.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@gltf-transform/core": "^4.4.2",
    "@gltf-transform/extensions": "^4.4.2",
    "@gltf-transform/functions": "^4.4.2",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.1",
    "draco3dgltf": "^1.5.7",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "galmuri": "^2.40.3",
    "globals": "^17.4.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
