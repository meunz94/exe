{
  "name": "vance-zip",
  "private": true,
  "version": "2.0.0",
  "type": "module",
  "scripts": {
    "content": "node scripts/build-content.mjs",
    "dev": "npm run content && vite",
    "build": "npm run content && tsc -b && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "prepare": "husky",
    "images": "node scripts/optimize-images.mjs",
    "notion:sync": "node --env-file-if-exists=.env scripts/notion-sync.mjs && npm run images",
    "notion:bootstrap": "node --env-file-if-exists=.env scripts/notion-bootstrap.mjs",
    "notion:seed": "node --env-file-if-exists=.env scripts/notion-seed.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^10.7.9",
    "@react-three/fiber": "^9.8.2",
    "react": "^19.2.4",
    "react-dom": "^19.2.4",
    "react-markdown": "^10.1.0",
    "rehype-raw": "^7.0.0",
    "three": "^0.183.2"
  },
  "lint-staged": {
    "*.{jpg,jpeg,png,webp,tiff,bmp}": "node scripts/strip-exif.mjs"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.4",
    "@types/node": "^24.12.2",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/three": "^0.183.1",
    "@vitejs/plugin-react": "^6.0.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.5.2",
    "globals": "^17.4.0",
    "gray-matter": "^4.0.3",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "sharp": "^0.34.5",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.58.0",
    "vite": "^8.0.4"
  }
}
